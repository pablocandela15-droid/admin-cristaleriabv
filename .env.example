# Proyecto de Supabase del panel (Settings › API): URL y clave pública (anon / publishable).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-anon>
VITE_SUPABASE_PUBLISHABLE_KEY=<clave-anon>

# Opcional: emails con acceso de super admin inmediato en el navegador (separados por comas).
# La autorización de verdad la da la tabla super_admins de la base de datos.
VITE_SUPER_ADMIN_EMAILS=
